# Required for the live AI tutor. Without it the lab still runs and Pip
# answers from scripted, stage-aware notes ("offline mode").
ANTHROPIC_API_KEY=

# Optional overrides
# TUTOR_MODEL=claude-opus-5
# TUTOR_EFFORT=medium   # low | medium | high

# Shared access password. When set, /lab and the tutor API require signing in
# at /login. Leave unset to run the lab without a gate (e.g. local development).
LAB_PASSWORD=
